      "elements": [
        { "id": "s1t", "kind": "text", "text": "The Waste Problem", "textStyle": "title", "color": "red", "position": { "x": 0.5, "y": 0.12 }, "size": 0.09, "revealAtWord": 0 },
        { "id": "s1e1", "kind": "icon", "assetTag": "building", "color": "blue", "position": { "x": 0.28, "y": 0.48 }, "size": 0.26, "revealAtWord": 0 },
