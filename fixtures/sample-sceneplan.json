      "layout": "timeline",
      "elements": [
        { "id": "s2t", "kind": "text", "text": "Why It Happens", "textStyle": "title", "color": "orange", "position": { "x": 0.5, "y": 0.12 }, "size": 0.085, "revealAtWord": 0 },
