        { "id": "s3e3", "kind": "arrow", "color": "green", "position": { "x": 0.38, "y": 0.48 }, "to": { "x": 0.46, "y": 0.72 }, "size": 0.11, "revealAtWord": 13 },
        { "id": "s3e4", "kind": "icon", "assetTag": "wifi", "color": "purple", "shade": true, "position": { "x": 0.48, "y": 0.8 }, "size": 0.16, "revealAtWord": 16 }
      ]
