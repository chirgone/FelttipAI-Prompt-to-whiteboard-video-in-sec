      ]
    },
    {
      "id": "s3",
      "narration": "FreshRoute puts tiny sensors inside produce crates, tracking temperature and humidity from the farm gate to the shelf.",
      "durationHintSec": 9,
      "layout": "flow",
      "elements": [
        { "id": "s3t", "kind": "text", "text": "The FreshRoute Fix", "textStyle": "title", "color": "green", "position": { "x": 0.5, "y": 0.12 }, "size": 0.085, "revealAtWord": 0 },
